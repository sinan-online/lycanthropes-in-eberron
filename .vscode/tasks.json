{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build LaTeX",
			"type": "shell",
			"command": "pdflatex",
			"args": [
				"-interaction=nonstopmode",
				"${file}"
			],
			"options": {
				"env": {
					"TEXINPUTS": "/workspace/classes//:"
				}
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "Build LaTeX Twice",
			"command": "sh",
			"args": [
				"-c",
				"pdflatex -interaction=nonstopmode \"${file}\" && pdflatex -interaction=nonstopmode \"${file}\""
			],
			"options": {
				"env": {
					"TEXINPUTS": "/workspace/classes//:"
				}
			},
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
			"label": "Open The Built PDF",
			"type": "shell",
			"command": "code",
			"args": [
				"-r",
				"${fileDirname}/${fileBasenameNoExtension}.pdf"
			],
			"dependsOn": ["Build LaTeX Twice"],
			"problemMatcher": []
		},
		{
			"label": "Pull",
			"type": "shell",
			"command": "git",
			"args": ["pull", "--ff-only"],
			"problemMatcher": []
		},
		{
			"label": "Push",
			"type": "shell",
			"command": "git",
			"args": ["push"],
			"problemMatcher": []
		},
		{
			"label": "Watch GitHub Action",
			"type": "shell",
			"command": "${workspaceFolder}/scripts/watch-action.sh",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "Push & Watch Build",
			"dependsOn": ["Push", "Watch GitHub Action"],
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
			"label": "Watch for Compiled PDF Updates",
			"type": "shell",
			"command": "${workspaceFolder}/scripts/watch-pdf.sh",
			"isBackground": true,
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Spell Check",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"aspell --lang=en --mode=tex --personal=/workspace/.aspell.en.pws list < '${file}' | sort -u"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": []
		}
	]
}
